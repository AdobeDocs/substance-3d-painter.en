# Copy this file to .env and fill in your values
# Never commit .env to version control

# Your Jira Personal Access Token
# How to get it:
#   1. Go to https://jira.corp.adobe.com/secure/ViewProfile.jspa
#   2. Click "Personal Access Tokens" in the left sidebar
#   3. Click "Create token", give it a name, and paste the value below
JIRA_PAT=your-jira-personal-access-token

# Version you are generating the known issues doc for.
# Issues marked Fixed in this version or earlier will be excluded.
# Issues marked Fixed in a later version will still be included.
TARGET_VERSION=12.0.3

# Output filename (optional, defaults to known-issues.md)
OUTPUT_FILE=known-issues.md
